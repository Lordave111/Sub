NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYSTACK_SECRET_KEY=sk_test_your_key
VTPASS_API_KEY=your_vtpass_api_key
VTPASS_PUBLIC_KEY=PK_your_public_key
VTPASS_SECRET_KEY=SK_your_secret_key
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead
ADMIN_PASSWORD=change-this-long-password
COMMISSION_PERCENT=20
NEXT_PUBLIC_COMMISSION_PERCENT=20
# Set to 0 for live VTpass only after sandbox testing
VTU_SANDBOX=true

# Optional live URL reputation checks (server-side only)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
# Official webhook verification; never use personal-account passwords
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Supabase auth user UUIDs allowed to moderate reports
FRAUDGUARD_ADMIN_USER_IDS=

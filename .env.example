# Required: Supabase project and server-side access
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Optional: AI-assisted scam analysis
OPENAI_API_KEY=
FRAUDGUARD_AI_MODEL=gpt-6.2-astra

# Optional: URL reputation checks (server-side only)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# Optional: social account protection OAuth (server-side secrets)
# Generate with: openssl rand -hex 48
SOCIAL_OAUTH_STATE_SECRET=
# Generate with: openssl rand -base64 32 (keep this stable after users connect accounts)
SOCIAL_TOKEN_ENCRYPTION_KEY=
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: official messaging platform webhook verification
META_WEBHOOK_VERIFY_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Optional: comma-separated Supabase Auth user UUIDs allowed to moderate reports
FRAUDGUARD_ADMIN_USER_IDS=
